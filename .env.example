# Токен бота из MAX. Единственная обязательная переменная.
BOT_TOKEN=

# Хранилище. Без него продукт поднимется на памяти, данные исчезнут при остановке.
DATABASE_URL=postgresql://localhost:5432/domovoy

# Порт продукта внутри машины. Наружу он смотрит через Caddy, поэтому менять
# его нужно, только если порт уже занят.
PORT=3000

# Адрес сайта для внешнего края. Пусто: Caddy слушает свой :80 без сертификата,
# и локально сайт открывается на http://localhost:8080. На боевой машине:
# SITE_ADDRESS=domovoy.homes, HTTP_PORT=80, HTTPS_PORT=443, и сертификат Caddy
# получит сам.
SITE_ADDRESS=
HTTP_PORT=8080
HTTPS_PORT=8443

# Дом по умолчанию, пока жилец не привязан к квартире.
DEFAULT_BUILDING_ID=dom15

# Первый управляющий: его идентификатор в MAX. Роли раздаёт управляющий,
# и без этого в свежей базе некому начать работу.
OWNER_MAX_ID=
OWNER_NAME=

# Ссылка на мини-приложение для кнопки «Открыть приложение» в чате.
#
# Именно ссылка платформы вида https://max.ru/<имя_бота>, а не адрес, где лежит
# статика: код объекта бот дописывает как ?startapp=<код>, и в параметры запуска
# приложения его кладёт платформа, по своей ссылке, не по чужой.
MINI_APP_URL=https://max.ru/<имя_бота>

# Адрес сайта продукта: оттуда открываются политика обработки персональных
# данных и пользовательское соглашение, ссылки на них бот даёт в переписке.
SITE_URL=https://domovoy.homes

# Ссылка на бота в MAX для лендинга: с ней на странице появляется кнопка
# «Открыть в MAX». Читается на сборке, поэтому задаётся до `docker compose up`.
VITE_BOT_LINK=https://max.ru/<имя_бота>

# Откуда мини-приложению разрешено обращаться к API, через запятую.
#
# По умолчанию не нужен: лендинг, приложение и API отдаёт один сервер с одного
# адреса, а у самого себя браузер разрешения не спрашивает. Заполняется, если
# статику раздаёт кто-то другой, и тогда же задаётся VITE_API_URL на сборке.
ALLOWED_ORIGINS=

# Кому можно открывать мини-приложение в рамке. Клиент MAX именно так и делает,
# поэтому по умолчанию разрешены его адреса и свой.
FRAME_ANCESTORS='self' https://max.ru https://*.max.ru

# Где лежит собранная статика. Пути от корня проекта, менять их нужно, только
# если лендинг или приложение раздаются откуда-то ещё.
LANDING_DIR=landing/dist
MINIAPP_DIR=apps/miniapp/dist

# Куда платформа шлёт апдейты. В боевом режиме MAX работает вебхуком, поэтому
# адрес обязан быть публичным и по HTTPS. Он на том же сервере, что и API:
# один адрес, один сертификат.
#
# Пусто, бот сам забирает апдейты опросом: на машине разработчика вебхуку
# приходить некуда. Секрет обязателен вместе с адресом, иначе апдейт примут
# от кого угодно; печатаемые символы ASCII, он едет в заголовке.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/bot/updates

# Где хранится позиция в потоке апдейтов.
#
# Файл переживает перезапуск: бот продолжает с того места, где остановился,
# а не с текущего момента. Без него всё, что пришло во время простоя, теряется.
MARKER_FILE=./state/marker

# Где лежат отметки регулярных проверок: о чём уже напомнили и что уже закрыли
# молчанием. Файл переживает перезапуск, иначе продукт повторит рассылку.
SWEEP_FILE=./state/sweep.json

# Общее хранилище состояния диалога и сессий мини-приложения.
#
# Без него диалог живёт в памяти процесса: после перезапуска жилец, начавший
# оформлять заявку, отправит описание в пустоту. Нужен и для нескольких реплик,
# иначе два сообщения одного человека затрут состояние друг друга, а токен,
# выданный одной репликой, не будет работать на другой.
# REDIS_URL=redis://localhost:6379

# Распознавание голосовых заявок.
#
# Голосом подают заявку ровно те, кто иначе позвонил бы в диспетчерскую.
# Без адреса службы такая заявка заводится, но приходит без описания.
# Годится любая служба, принимающая запись формой (поле `file`) и отвечающая
# {"text": "…"}, в том числе поднятая внутри контура.
# SPEECH_URL=https://<адрес>/v1/audio/transcriptions
# SPEECH_KEY=
# SPEECH_MODEL=
# SPEECH_LANGUAGE=ru

# Модель. Сначала продукт смотрит на GigaChat: российская инфраструктура
# и бесплатный режим. Authorization key берётся в личном кабинете Сбера: это пара
# Client ID и Client Secret в base64. Область: GIGACHAT_API_PERS у физического лица,
# GIGACHAT_API_B2B у юридического. Токен живёт полчаса, продукт обновляет его сам.
# Для TLS нужен корень «Russian Trusted Root CA»: в образе он уже подключён.
# Бесплатный режим держит один поток, поэтому запросы к модели идут по очереди.
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: по умолчанию GigaChat-2-Max, 25 млн токенов в год в бесплатном режиме.
# Младшие модели: GigaChat-2 (Lite, 250 млн) и GigaChat-2-Pro (40 млн).
# GIGACHAT_MODEL=GigaChat-2-Max
# GIGACHAT_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# Любая другая служба с чатом в формате OpenAI: и локальная, и облачная.
# Модель используется в шести местах:
#   категория, срочность, объект дома, часть дома и заголовок обращения;
#   вопрос это или заявка, и о чём вопрос;
#   к какому разделу приложения относится написанное;
#   уточняющий вопрос об адресе обращения и подписи кнопок к нему;
#   ответ помощника по приложению и раздел, в который он ведёт,
#     с отдельной проверкой, о доме ли вообще спросили;
#   пересказ сводки по дому двумя предложениями.
# Срок модель не назначает, его считает регламент по категории. Ответы жильцу
# продукт собирает из своих данных, модель только относит вопрос к теме.
# Без модели всё это работает на правилах и ключевых словах.
# REASONER_URL=https://<адрес>/v1/chat/completions
# REASONER_KEY=
# REASONER_MODEL=

# Показание с фотографии табло. Подходит служба с чатом в формате OpenAI,
# понимающая изображения. Без адреса показание вводится цифрами.
# METER_VISION_URL=https://<адрес>/v1/chat/completions
# METER_VISION_KEY=
# METER_VISION_MODEL=

# Заглушки вместо поставщиков: домофония и платёжный шлюз отвечают в памяти.
# Нужны для показа и разработки. В бою вместо них подключается адаптер поставщика.
# Без поставщика раздела нет вовсе: без домофонии из приложения и меню бота уходит
# «Дом», без платёжного шлюза остаются суммы, но не кнопка оплаты.
# HUB=mock
# PAYMENTS=mock

# Канал передачи обращений смежным организациям: ресурсникам, подрядчику,
# муниципальной службе, жилинспекции. `mock` подтверждает приём и выдаёт номер,
# настоящего обмена за ним нет, и человек видит это в карточке заявки. Без
# переменной передача записывается как ручная: письмом или звонком.
# HANDOFF=mock
# Как назвать канал в журнале: gis_zhkh, pos, email.
# HANDOFF_CHANNEL=

# Система, в которой заочное собрание собственников имеет силу: ГИС ЖКХ или
# «Госуслуги.Дом». `mock` подтверждает размещение сообщения, приём решений
# и публикацию протокола, настоящей передачи за ним нет. Без переменной
# продукт готовит собрание и считает голоса, но в систему ничего не уходит.
# MEETINGS=mock
# Как система называется человеку.
# MEETINGS_TITLE=ГИС ЖКХ

# Сведения о капитальном ремонте: их ведёт региональная программа, а не
# управляющая организация. `mock` отдаёт типовой план и взнос, настоящего
# обмена за ним нет. Без переменной раздела капремонта в приложении нет.
# CAPITAL_REPAIR=mock
# Как источник называется человеку.
# CAPITAL_REPAIR_TITLE=

# Общий секрет с домофонией. С ним открываются два маршрута для её событий:
# срабатывание датчика и вход по гостевому коду. Без секрета маршрутов нет вовсе.
# HUB_SECRET=

# Адрес Bot API. Подменяется на локальный эмулятор при разработке без токена.
# MAX_API_URL=http://localhost:8080

# Имя бота для ссылок на наклейках: `https://max.ru/<имя>?start=<код>`. По нему они
# собираются и в приложении, и в боте, и в команде печати. Без него, `uk_bot`.
# BOT_NAME=uk_bot

# Кто может смотреть /metrics. Без токена страница открыта всем, кто знает адрес.
# METRICS_TOKEN=

# Корень доверия для Bot API MAX. Платформа отдаёт сертификат «Russian Trusted
# Sub CA», корня которого в наборе Node.js нет: без него ни один запрос к MAX
# не проходит. В образе переменная уже задана, при запуске без Docker задают её
# сами. Подробнее: certs/README.md
NODE_EXTRA_CA_CERTS=./certs/russian-trusted-root-ca.pem

# Проверка ролями. Жюри смотрит продукт под одной учётной записью MAX, поэтому
# в приложении появляется раздел «Роль», а в боте команда /demo: человек
# примеряет роль жильца, диспетчера, мастера, управляющего или подрядчика.
# В обычной установке роль выдаёт управляющий, а раздела и команды нет.
# DEMO_ROLES=1
