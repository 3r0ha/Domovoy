# Внешний край: сертификат и переадресация на продукт. Всё остальное отдаёт
# сам продукт, поэтому здесь нет ни путей, ни правил маршрутизации.
#
# Локально это просто порт, и Caddy слушает его без сертификата: наружу
# это localhost:8080. На машине с доменом достаточно задать
# SITE_ADDRESS=domovoy.homes, HTTP_PORT=80 и HTTPS_PORT=443: сертификат Caddy
# получит сам.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Насколько файл живёт в кеше, решает сам продукт: он один знает, у какого
	# имени есть отпечаток содержимого. Второй такой заголовок здесь только мешал бы.
	reverse_proxy domovoy:3000

	log {
		output stdout
		format console
	}
}
