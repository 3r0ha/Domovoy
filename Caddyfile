# Внешний край: сертификат и переадресация на продукт. Всё остальное отдаёт
# сам продукт, поэтому здесь нет ни путей, ни правил маршрутизации.
#
# Локально это просто порт, и Caddy слушает его без сертификата: наружу
# это localhost:8080. На машине с доменом достаточно задать
# SITE_ADDRESS=domovoy.homes, HTTP_PORT=80 и HTTPS_PORT=443: сертификат Caddy
# получит сам.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Заголовок действует только по https; локальный http браузер его не запоминает.
	header Strict-Transport-Security "max-age=31536000"

	# Насколько файл живёт в кеше, решает сам продукт: он один знает, у какого
	# имени есть отпечаток содержимого. Второй такой заголовок здесь только мешал бы.
	reverse_proxy domovoy:3000

	log {
		output stdout
		format console
	}
}

# Имя с www ведёт на основной адрес. Локально это имя никто не набирает.
{$WWW_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Запасное имя того же продукта. Основной домен могут отфильтровать по имени
# на пути к серверу, и тогда продукт открывается по этому адресу. Без
# ALT_ADDRESS блок слушает порт, который наружу не выведен.
{$ALT_ADDRESS::81} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy domovoy:3000

	log {
		output stdout
		format console
	}
}
